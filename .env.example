# Adresse de l API locale. Laisser vide pour http://localhost:3000.
VITE_API_URL=

# Identifiant du client OAuth Google. Le meme que GOOGLE_CLIENT_ID de
# server/.env ; le secret, lui, ne quitte jamais le serveur.
VITE_GOOGLE_CLIENT_ID=

# Mot de passe PostgreSQL, lu par docker compose. Vide = 'idea', ce qui convient
# en local. En production : une valeur engendree, identique a celle du
# DATABASE_URL de server/.env.
POSTGRES_PASSWORD=
