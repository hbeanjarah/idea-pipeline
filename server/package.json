{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "prepare": "pnpm run generate:types",
    "dev": "tsx watch --env-file=.env --conditions=development src/index.ts",
    "generate:types": "openapi-typescript ../docs/openapi.yaml --root-types --root-types-no-schema-prefix --enum-values -o src/domain/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.6.4"
  }
}
